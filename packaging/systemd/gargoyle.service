[Unit]
Description=Project GARGOYLE Linux Security Watchdog
Documentation=https://github.com/bobbymayyy/GARGOYLE
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/gargoyle run --config /etc/gargoyle/gargoyle.toml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
User=root
Group=root
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gargoyle

# Privilege and filesystem cage
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ReadWritePaths=/var/log/gargoyle /run/gargoyle

# Process and syscall hardening
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@clock @debug @module @mount @raw-io @reboot @swap

# The core agent reads procfs and emits only locally.
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
